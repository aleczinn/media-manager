{
    "name": "media-manager",
    "version": "0.1.0",
    "description": "Grafisches Tool zum Normalisieren und Umbenennen von Mediendateien",
    "main": "./out/main/index.js",
    "private": true,
    "scripts": {
        "dev": "electron-vite dev",
        "build": "electron-vite build",
        "preview": "electron-vite preview",
        "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
        "test": "vitest run",
        "dist": "electron-vite build && electron-builder --win",
        "check": "tsx scripts/corruption-checker.ts"
    },
    "pnpm": {
        "onlyBuiltDependencies": [
            "electron",
            "esbuild"
        ]
    },
    "dependencies": {
        "mediainfo.js": "^0.3.8"
    },
    "devDependencies": {
        "@dnd-kit/core": "^6.3.1",
        "@dnd-kit/modifiers": "^9.0.0",
        "@dnd-kit/sortable": "^10.0.0",
        "@dnd-kit/utilities": "^3.2.2",
        "@tailwindcss/vite": "^4.3.3",
        "@types/node": "^26.6.5",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "electron": "^45.0.0",
        "electron-builder": "^26.18.0",
        "electron-vite": "^6.0.0",
        "lucide-react": "^1.61.0",
        "radix-ui": "^1.8.1",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "tailwind-merge": "^3.7.0",
        "tailwindcss": "^4.3.3",
        "tsx": "^4.23.15",
        "tw-animate-css": "^1.4.0",
        "typescript": "^7.0.2",
        "vite": "^8.3.5",
        "vitest": "^5.0.5",
        "zustand": "^5.0.16"
    }
}
